{
  "name": "k6boost",
  "version": "0.1.0",
  "description": "A safety-conscious CLI for repeatable API performance tests powered by Grafana k6",
  "type": "module",
  "bin": { "k6boost": "./dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["k6", "performance-testing", "load-testing", "api-testing", "cli"],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}